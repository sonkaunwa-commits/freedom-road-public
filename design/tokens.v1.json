{
  "schema_version": "1.0",
  "token_set": "freovia-design-v1",
  "version": "1.0.0",
  "updated_at": "2026-09-02",
  "typography": {
    "font_family": "system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
    "body_px": 16,
    "metadata_px": 13,
    "body_line_height": 1.5,
    "heading_line_height": 1.25,
    "financial_numeric_variant": "tabular-nums"
  },
  "spacing_px": [4, 8, 12, 16, 24, 32, 48],
  "radius_px": {
    "sm": 6,
    "md": 10,
    "lg": 16
  },
  "tap_target_min_px": 44,
  "semantic_states": {
    "FRESH": {"category": "freshness", "requires_text_label": true},
    "DELAYED": {"category": "freshness", "requires_text_label": true},
    "STALE": {"category": "freshness", "requires_text_label": true},
    "DEGRADED": {"category": "availability", "requires_text_label": true},
    "UNAVAILABLE": {"category": "availability", "requires_text_label": true},
    "PROVISIONAL": {"category": "finality", "requires_text_label": true},
    "OFFICIAL": {"category": "finality", "requires_text_label": true}
  },
  "financial_display": {
    "missing_value_must_not_render_as_zero": true,
    "gain_loss_requires_sign_and_unit": true,
    "delayed_quote_requires_disclosure": true,
    "portfolio_total_requires_valuation_timestamp": true,
    "fallback_quality_change_requires_visible_state": true
  },
  "accessibility": {
    "target": "WCAG-AA",
    "meaning_must_not_depend_on_color": true,
    "visible_keyboard_focus": true,
    "respect_reduced_motion": true
  }
}