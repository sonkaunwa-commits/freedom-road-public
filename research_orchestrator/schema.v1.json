{
  "schema_version": "1.0",
  "record_type": "freovia_research_record",
  "required": [
    "research_id",
    "question",
    "as_of",
    "sources",
    "evidence",
    "contradictions",
    "findings",
    "confidence",
    "status"
  ],
  "enums": {
    "source_quality": ["PRIMARY", "HIGH", "STANDARD", "LOW", "UNKNOWN"],
    "freshness": ["CURRENT", "RECENT", "STALE", "UNKNOWN"],
    "evidence_type": ["FACT", "INFERENCE", "OPINION"],
    "contradiction_status": ["OPEN", "RESOLVED", "ACCEPTED_UNCERTAINTY"],
    "research_status": ["DRAFT", "REVIEWED", "FINAL", "ARCHIVED"],
    "confidence": ["LOW", "MEDIUM", "HIGH"]
  },
  "rules": {
    "source_ids_unique": true,
    "evidence_ids_unique": true,
    "finding_ids_unique": true,
    "fact_requires_source_refs": true,
    "inference_requires_evidence_refs": true,
    "finding_requires_evidence_refs": true,
    "open_contradiction_blocks_high_confidence_final": true,
    "current_fact_cannot_use_only_stale_or_unknown_sources": true,
    "opinion_must_not_claim_source_fact": true
  }
}