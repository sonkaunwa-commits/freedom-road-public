{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freovia.com/schemas/skill-registry-v1.json",
  "title": "FREOVIA Skill Registry v1",
  "type": "object",
  "required": ["schema_version", "registry_id", "updated_at", "entries"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "registry_id": {"const": "freovia-skill-registry-v1"},
    "updated_at": {"type": "string", "minLength": 10},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "skill_id",
          "name",
          "source",
          "problem",
          "input_contract",
          "output_contract",
          "permissions",
          "overlap_with_existing",
          "maintenance",
          "risk",
          "cost",
          "status",
          "alternatives",
          "last_evaluated_at"
        ],
        "properties": {
          "skill_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
          "name": {"type": "string", "minLength": 2},
          "source": {
            "type": "object",
            "required": ["type", "ref"],
            "properties": {
              "type": {"enum": ["INTERNAL", "GITHUB", "MCP", "PLUGIN", "API", "OTHER"]},
              "ref": {"type": "string", "minLength": 1},
              "version": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          },
          "problem": {"type": "string", "minLength": 10},
          "input_contract": {"type": "string", "minLength": 3},
          "output_contract": {"type": "string", "minLength": 3},
          "permissions": {
            "type": "array",
            "items": {"enum": ["NONE", "NETWORK_READ", "NETWORK_WRITE", "REPO_READ", "REPO_WRITE", "FILESYSTEM_READ", "FILESYSTEM_WRITE", "PRIVATE_DATA_READ", "PRIVATE_DATA_WRITE", "SECRETS_READ", "EXTERNAL_ACTION"]},
            "minItems": 1,
            "uniqueItems": true
          },
          "overlap_with_existing": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "maintenance": {
            "type": "object",
            "required": ["owner", "activity_state"],
            "properties": {
              "owner": {"type": "string", "minLength": 1},
              "activity_state": {"enum": ["ACTIVE", "SLOW", "UNKNOWN", "INTERNAL"]}
            },
            "additionalProperties": false
          },
          "risk": {
            "type": "object",
            "required": ["security", "privacy"],
            "properties": {
              "security": {"enum": ["LOW", "MEDIUM", "HIGH"]},
              "privacy": {"enum": ["LOW", "MEDIUM", "HIGH"]}
            },
            "additionalProperties": false
          },
          "cost": {
            "type": "object",
            "required": ["class", "notes"],
            "properties": {
              "class": {"enum": ["ZERO", "LOW", "VARIABLE", "PAID"]},
              "notes": {"type": "string"}
            },
            "additionalProperties": false
          },
          "status": {"enum": ["WATCH", "PILOT", "APPROVED", "DEPRECATED", "REJECTED"]},
          "metrics": {
            "type": "object",
            "properties": {
              "success_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
              "p95_latency_ms": {"type": ["number", "null"], "minimum": 0},
              "evaluated_runs": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          },
          "approval_evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "alternatives": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "last_evaluated_at": {"type": "string", "minLength": 10},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}